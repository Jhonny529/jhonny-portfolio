---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
}

const {
  title = 'Jhonny Sanes | Backend Engineer',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <ClientRouter />

    <script is:inline>
      (() => {
        if (window.__themeInit) return;
        window.__themeInit = true;

        const root = document.documentElement;

        const applyTheme = () => {
          const isDark = localStorage.getItem('theme') !== 'light';
          root.classList.toggle('dark', isDark);
          root.style.colorScheme = isDark ? 'dark' : 'light';
        };

        applyTheme();

        // Con <ClientRouter />, Astro borra los atributos del <html> actual y los
        // reemplaza por los del documento entrante en cada navegación. Sin esto,
        // cambiar de idioma descartaría el tema elegido.
        document.addEventListener('astro:after-swap', applyTheme);

        // El botón se reemplaza en cada navegación, pero Astro no vuelve a ejecutar
        // un script idéntico al que ya corrió, así que un listener puesto sobre el
        // botón se perdería. Delegamos en document, que sí sobrevive al swap.
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element) || !target.closest('#theme-toggle')) return;

          localStorage.setItem(
            'theme',
            root.classList.contains('dark') ? 'light' : 'dark',
          );
          applyTheme();
        });
      })();
    </script>
  </head>

  <body
    class="min-h-screen bg-neutral-50 text-neutral-900 antialiased transition-colors duration-300 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }
</style>