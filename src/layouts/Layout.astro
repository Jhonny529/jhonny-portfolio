---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
}

const meta = {
  en: {
    title: 'Jhonny Sanes | Backend Engineer',
    description:
      'Backend engineer focused on architecture, scalable APIs, and production-ready infrastructure. Node.js, TypeScript, PostgreSQL, Prisma, Docker.',
    locale: 'en_US',
  },
  es: {
    title: 'Jhonny Sanes | Ingeniero Backend',
    description:
      'Ingeniero backend enfocado en arquitectura, APIs escalables e infraestructura lista para producción. Node.js, TypeScript, PostgreSQL, Prisma, Docker.',
    locale: 'es_PE',
  },
};

const { lang = 'en' } = Astro.props;
const { title = meta[lang].title, description = meta[lang].description } = Astro.props;

// Astro.site solo existe si se define `site` en astro.config.mjs. Sin él no hay forma
// de construir las URLs absolutas que exigen los crawlers (canonical, og:url,
// og:image), así que esas etiquetas se omiten en vez de emitirse rotas.
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : null;
const ogImage = site ? new URL('/Jhonny.png', site).href : null;

const alternates = site
  ? [
      { hreflang: 'en', href: new URL('/', site).href },
      { hreflang: 'es', href: new URL('/es/', site).href },
      { hreflang: 'x-default', href: new URL('/', site).href },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jhonny Sanes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={meta[lang].locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <ClientRouter />

    <script is:inline>
      (() => {
        if (window.__themeInit) return;
        window.__themeInit = true;

        const root = document.documentElement;

        const applyTheme = () => {
          const isDark = localStorage.getItem('theme') !== 'light';
          root.classList.toggle('dark', isDark);
          root.style.colorScheme = isDark ? 'dark' : 'light';
        };

        applyTheme();

        // Con <ClientRouter />, Astro borra los atributos del <html> actual y los
        // reemplaza por los del documento entrante en cada navegación. Sin esto,
        // cambiar de idioma descartaría el tema elegido.
        document.addEventListener('astro:after-swap', applyTheme);

        // El botón se reemplaza en cada navegación, pero Astro no vuelve a ejecutar
        // un script idéntico al que ya corrió, así que un listener puesto sobre el
        // botón se perdería. Delegamos en document, que sí sobrevive al swap.
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element) || !target.closest('#theme-toggle')) return;

          localStorage.setItem(
            'theme',
            root.classList.contains('dark') ? 'light' : 'dark',
          );
          applyTheme();
        });
      })();
    </script>
  </head>

  <body
    class="min-h-screen bg-neutral-50 text-neutral-900 antialiased transition-colors duration-300 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }
</style>