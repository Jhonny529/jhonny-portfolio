---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'en' } = Astro.props;

const nav = {
  en: {
    home: 'Home',
    about: 'About',
    projects: 'Projects',
    experience: 'Experience',
    contact: 'Contact',
    open_menu: 'Open menu',
  },
  es: {
    home: 'Inicio',
    about: 'Sobre mí',
    projects: 'Proyectos',
    experience: 'Experiencia',
    contact: 'Contacto',
    open_menu: 'Abrir menú',
  },
};

const t = nav[lang];

// Etiquetas del otro idioma: se renderizan ocultas para reservar su ancho, de modo
// que los enlaces no cambien de tamaño ni se desplacen al alternar EN <-> ES.
const other = nav[lang === 'en' ? 'es' : 'en'];

const items = [
  { href: '#home', key: 'home', icon: 'home' },
  { href: '#about', key: 'about', icon: 'user' },
  // { href: '#projects', key: 'projects', icon: 'projects' },
  { href: '#experience', key: 'experience', icon: 'briefcase' },
  { href: '#contact', key: 'contact', icon: 'mail' },
] as const;
---

<header class="sticky top-0 z-50 border-b border-neutral-200/80 bg-white/75 backdrop-blur-xl transition-colors duration-300 dark:border-white/10 dark:bg-neutral-950/75">
  <div class="mx-auto grid max-w-6xl grid-cols-[auto_1fr] items-center px-6 py-4 md:grid-cols-[120px_1fr_auto]">
    <!-- Hamburger: solo mobile -->
    <button
      id="menu-toggle"
      type="button"
      class="menu-btn md:hidden"
      aria-label={t.open_menu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="menu-icon menu-icon--open"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>

      <svg
        class="menu-icon menu-icon--close"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <!-- Spacer desktop -->
    <div aria-hidden="true" class="hidden h-10 w-[120px] md:block"></div>

    <!-- Nav desktop -->
    <nav class="hidden items-center justify-center gap-3 md:flex" aria-label="Primary navigation">
      {items.map((item) => (
        <a href={item.href} class="nav-link">
          <Icon name={item.icon} className="nav-icon" size={18} />
          <span class="nav-label">
            <span>{t[item.key]}</span>
            <span class="nav-label__ghost" aria-hidden="true">{other[item.key]}</span>
          </span>
        </a>
      ))}
    </nav>

    <!-- Controles -->
    <div class="flex items-center justify-end gap-3">
      <LanguageSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>

  <!-- Drawer mobile -->
  <div
    id="mobile-menu"
    class="mobile-menu md:hidden"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-1 px-4 py-3" aria-label="Mobile navigation">
      {items.map((item) => (
        <a href={item.href} class="mobile-nav-link">
          <Icon name={item.icon} size={18} />
          <span>{t[item.key]}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    if (window.__menuInit) return;
    window.__menuInit = true;

    // El header se vuelve a renderizar en cada navegación de idioma y Astro no
    // reejecuta este script, así que los listeners van sobre document/window y el
    // estado se lee del DOM en vez de guardarse en una variable local.
    const setOpen = (value) => {
      const btn = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;

      btn.setAttribute('aria-expanded', String(value));
      menu.setAttribute('aria-hidden', String(!value));
      menu.classList.toggle('mobile-menu--open', value);
    };

    const isOpen = () =>
      document.getElementById('menu-toggle')?.getAttribute('aria-expanded') === 'true';

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('#menu-toggle')) {
        setOpen(!isOpen());
      } else if (target.closest('#mobile-menu a')) {
        setOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen()) setOpen(false);
    });
  })();
</script>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.78rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    color: rgb(64 64 64);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  /* Ambas etiquetas comparten la misma celda del grid, así que el ancho del
     enlace lo fija la más larga de los dos idiomas y nunca cambia. */
  .nav-label {
    display: grid;
    justify-items: center;
  }

  .nav-label > * {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .nav-label__ghost {
    height: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(.dark) .nav-link {
    color: rgb(229 229 229);
  }

  .nav-link:hover {
    background: rgba(0, 0, 0, 0.04);
    color: rgb(23 23 23);
  }

  :global(.dark) .nav-link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: white;
  }

  .nav-link span {
    white-space: nowrap;
  }

  .menu-btn {
    padding: 0.5rem;
    border-radius: 0.5rem;
    border: none;
    background: transparent;
    color: rgb(64 64 64);
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }

  :global(.dark) .menu-btn {
    color: rgb(229 229 229);
  }

  .menu-btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  :global(.dark) .menu-btn:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  /* Icono según el estado del drawer, sin tocar estilos inline desde JS */
  .menu-icon--close,
  .menu-btn[aria-expanded='true'] .menu-icon--open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .menu-icon--close {
    display: block;
  }

  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    border-top: 1px solid transparent;
    transition:
      max-height 300ms ease,
      border-color 300ms ease;
  }

  .mobile-menu--open {
    max-height: 400px;
    border-color: rgb(229 229 229 / 0.6);
  }

  :global(.dark) .mobile-menu--open {
    border-color: rgb(255 255 255 / 0.08);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.75rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: rgb(64 64 64);
    font-size: 0.95rem;
    font-weight: 500;
    transition:
      background 200ms ease,
      color 200ms ease;
  }

  :global(.dark) .mobile-nav-link {
    color: rgb(229 229 229);
  }

  .mobile-nav-link:hover {
    background: rgba(0, 0, 0, 0.04);
    color: rgb(23 23 23);
  }

  :global(.dark) .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: white;
  }
</style>