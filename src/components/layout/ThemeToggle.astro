---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'en' } = Astro.props;

const labelMap = {
  en: { dark: 'Dark', light: 'Light', aria: 'Toggle theme' },
  es: { dark: 'Oscuro', light: 'Claro', aria: 'Cambiar tema' },
};

const t = labelMap[lang];
---

<!--
  El estado visual se resuelve solo con CSS a partir de la clase .dark del <html>.
  El click lo maneja el listener delegado de Layout.astro, porque este componente
  se vuelve a renderizar en cada navegación de idioma.
-->
<button id="theme-toggle" type="button" class="theme-toggle" aria-label={t.aria}>
  <!-- Moon: visible en dark mode -->
  <svg
    class="theme-icon theme-icon--moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/>
  </svg>

  <!-- Sun: visible en light mode -->
  <svg
    class="theme-icon theme-icon--sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>

  <span class="theme-label theme-label--dark">{t.dark}</span>
  <span class="theme-label theme-label--light">{t.light}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    min-width: 108px;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 9999px;
    border: 1px solid rgb(212 212 212 / 0.6);
    background: rgb(255 255 255 / 0.7);
    padding: 0.62rem 0.95rem;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    color: rgb(64 64 64);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  :global(.dark) .theme-toggle {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.04);
    color: rgb(229 229 229);
  }

  .theme-toggle:hover {
    background: rgb(255 255 255);
    color: rgb(23 23 23);
  }

  :global(.dark) .theme-toggle:hover {
    background: rgb(255 255 255 / 0.07);
    color: white;
  }

  .theme-icon {
    flex-shrink: 0;
  }

  /* Light mode: sol + etiqueta "Light" / "Claro" */
  .theme-icon--moon,
  .theme-label--dark {
    display: none;
  }

  /* Dark mode: luna + etiqueta "Dark" / "Oscuro" */
  :global(.dark) .theme-icon--moon,
  :global(.dark) .theme-label--dark {
    display: inline-block;
  }

  :global(.dark) .theme-icon--sun,
  :global(.dark) .theme-label--light {
    display: none;
  }
</style>